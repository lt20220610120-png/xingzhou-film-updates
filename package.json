{
  "name": "xingzhou-film",
  "productName": "行舟影视",
  "version": "1.9.4",
  "description": "行舟影视：剧本、导演、项目协作与 AI 影像生产工作台",
  "author": "行舟影视",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "build": "vite build",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "dist": "npm run test && npm run build && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "mammoth": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "pngjs": "^7.0.0",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.xingzhou.film",
    "productName": "行舟影视",
    "directories": {
      "output": "C:/Users/11599/AppData/Local/Temp/xingzhou-release-v194"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "canvas-app/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "行舟影视-安装程序-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "行舟影视"
    }
  }
}
